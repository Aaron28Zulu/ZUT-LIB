rules_version = '2';

// Cloud mode keeps the app's saved state in zutlib_kv (lib/data/firestore_storage.dart).
// Only signed-in clients (Google or the app's anonymous session) may read or write.
// Tenant isolation and role checks run in the service layer (FR-TEN-02, FR-AUTH-08);
// per-tenant rules come with real per-user Firebase accounts.
service cloud.firestore {
  match /databases/{database}/documents {
    match /zutlib_kv/{key} {
      allow read, write: if request.auth != null;
      match /parts/{part} {
        allow read, write: if request.auth != null;
      }
    }
  }
}
