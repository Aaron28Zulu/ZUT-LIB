#!/bin/sh
# Rejects commit messages that break docs/COMMITS.md.
msg=$(head -n1 "$1")
case "$msg" in
  Merge*|Revert*|fixup!*|squash!*) exit 0 ;;
esac
pattern='^(feat|fix|refactor|test|docs|style|chore|perf|build|ci|revert)(\([a-z0-9-]+\))?!?: [a-z0-9].*[^.]$'
if ! printf '%s' "$msg" | grep -Eq "$pattern"; then
  echo "Commit message must be: type(scope): imperative summary (see docs/COMMITS.md)" >&2
  exit 1
fi
if [ "${#msg}" -gt 72 ]; then
  echo "Commit message is ${#msg} characters; the limit is 72." >&2
  exit 1
fi
lines=$(grep -cv '^\s*\(#.*\)\?$' "$1")
if [ "$lines" -gt 1 ]; then
  echo "Commit message must be a single line (see docs/COMMITS.md)." >&2
  exit 1
fi
